# Copy to .env and fill in to enable LIVE (non-mock) localization.
# With no LLM_API_KEY set, the service runs in MOCK mode (templated steps +
# estimated carbon) — the demo works with zero secrets.

# Provider preset: scaleway | greenpt | mistral | qwen | salamandra | aya | groq
LLM_PROVIDER=scaleway

# Override the preset's base_url / model if needed (all OpenAI-compatible):
# LLM_BASE_URL=https://api.scaleway.ai/v1
# LLM_MODEL=mistral-small-3.2-24b-instruct-2506

# Your provider API key. Leave empty to stay in mock mode.
LLM_API_KEY=

# Force mock mode even if a key is present:
# LLM_MOCK=1

# Which provider EcoLogits should use for impact estimation (default: openai):
ECOLOGITS_PROVIDER=openai

PORT=8000
